# Copy to .env.local and fill in from your Supabase project:
# Settings -> API. .env.local is gitignored — never commit real values here.
#
# Cloud sync is entirely optional: with these unset, the app runs exactly as
# it always has, local-only, no network calls. See supabase/schema.sql for
# the tables this expects to find.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
